# Salin file ini menjadi .env lalu sesuaikan nilainya. JANGAN commit file .env.

# development | testing | production
APP_ENV=development

# Wajib diganti di production (APP_ENV=production akan menolak nilai default)
SECRET_KEY=ganti-dengan-string-acak-yang-panjang

# SQLite (default, disimpan di folder instance/)
DATABASE_URL=sqlite:///iot_monitor.db
# MySQL / MariaDB (butuh: pip install PyMySQL)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/iot_monitor

# Opsional: bila diisi, semua request tulis (POST/PUT/PATCH/DELETE)
# wajib mengirim header X-API-Key dengan nilai ini. Kosong = dimatikan.
API_KEY=
