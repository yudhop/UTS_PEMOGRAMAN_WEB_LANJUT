digraph ERD {
  graph [rankdir=LR, splines=true, nodesep=0.6, ranksep=1.2, fontname="Helvetica", pad=0.4, bgcolor="white"];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#475569", dir=both, arrowtail=nonetee, arrowhead=crow];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>users</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="username"><B>username</B></TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD ALIGN="LEFT">UQ</TD></TR><TR><TD ALIGN="LEFT" PORT="email"><B>email</B></TD><TD ALIGN="LEFT">VARCHAR(120)</TD><TD ALIGN="LEFT">UQ</TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash"><B>password_hash</B></TD><TD ALIGN="LEFT">VARCHAR(255)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="role"><B>role</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><B>created_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><B>updated_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  devices [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#dcfce7"><B>devices</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="owner_id"><B>owner_id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="name"><B>name</B></TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="serial_number"><B>serial_number</B></TD><TD ALIGN="LEFT">VARCHAR(64)</TD><TD ALIGN="LEFT">UQ</TD></TR><TR><TD ALIGN="LEFT" PORT="device_type"><B>device_type</B></TD><TD ALIGN="LEFT">VARCHAR(30)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="location"><B>location</B></TD><TD ALIGN="LEFT">VARCHAR(120)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><B>status</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="firmware_version"><B>firmware_version</B></TD><TD ALIGN="LEFT">VARCHAR(30)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="last_seen_at"><B>last_seen_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><B>created_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><B>updated_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  sensors [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#dcfce7"><B>sensors</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="device_id"><B>device_id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="name"><B>name</B></TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="sensor_type"><B>sensor_type</B></TD><TD ALIGN="LEFT">VARCHAR(30)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="unit"><B>unit</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="min_value"><B>min_value</B></TD><TD ALIGN="LEFT">FLOAT</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="max_value"><B>max_value</B></TD><TD ALIGN="LEFT">FLOAT</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><B>created_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><B>updated_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  telemetry_readings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fef9c3"><B>telemetry_readings</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="sensor_id"><B>sensor_id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="value"><B>value</B></TD><TD ALIGN="LEFT">FLOAT</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="recorded_at"><B>recorded_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><B>created_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  alert_rules [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fee2e2"><B>alert_rules</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="sensor_id"><B>sensor_id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="name"><B>name</B></TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="operator"><B>operator</B></TD><TD ALIGN="LEFT">VARCHAR(5)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="threshold"><B>threshold</B></TD><TD ALIGN="LEFT">FLOAT</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="severity"><B>severity</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active"><B>is_active</B></TD><TD ALIGN="LEFT">BOOLEAN</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><B>created_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><B>updated_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  alerts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fee2e2"><B>alerts</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="rule_id"><B>rule_id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="reading_id"><B>reading_id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">FK, null</TD></TR><TR><TD ALIGN="LEFT" PORT="acknowledged_by_id"><B>acknowledged_by_id</B></TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT">FK, null</TD></TR><TR><TD ALIGN="LEFT" PORT="severity"><B>severity</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="message"><B>message</B></TD><TD ALIGN="LEFT">VARCHAR(255)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><B>status</B></TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="triggered_at"><B>triggered_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="acknowledged_at"><B>acknowledged_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT" PORT="resolved_at"><B>resolved_at</B></TD><TD ALIGN="LEFT">DATETIME</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  users:id -> devices:owner_id [label="owns (RESTRICT)"];
  devices:id -> sensors:device_id [label="has (CASCADE)"];
  sensors:id -> telemetry_readings:sensor_id [label="records (CASCADE)"];
  sensors:id -> alert_rules:sensor_id [label="monitored by (CASCADE)"];
  alert_rules:id -> alerts:rule_id [label="triggers (CASCADE)"];
  telemetry_readings:id -> alerts:reading_id [label="source of (SET NULL)"];
  users:id -> alerts:acknowledged_by_id [label="acknowledges (SET NULL)"];
}
