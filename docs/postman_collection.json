{
  "info": {
    "name": "IoT Monitor API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection pengujian manual IoT Monitor API v1.0.\n\nCara pakai: jalankan `flask db upgrade && flask seed`, jalankan server, lalu jalankan folder 1-9 secara berurutan (Runner) — setiap request menyimpan ID yang dipakai request berikutnya. Isi variabel `api_key` hanya jika server memakai API_KEY."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000/api/v1"
    },
    {
      "key": "api_key",
      "value": ""
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Users",
