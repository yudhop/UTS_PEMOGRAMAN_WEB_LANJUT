    {
      "name": "6. Telemetry & Alert generation",
      "item": [
        {
          "name": "Send normal reading (25 °C)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/telemetry",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "telemetry"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensor_id\": {{sensor_id}},\n  \"value\": 25.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test(\"No alert triggered\", function () { pm.expect(json.data.triggered_alerts).to.have.lengthOf(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Send reading above threshold (40 °C)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/telemetry",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "telemetry"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensor_id\": {{sensor_id}},\n  \"value\": 40.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"reading_id\", json.data.id);",
                  "pm.collectionVariables.set(\"alert_id\", json.data.triggered_alerts[0].id);",
                  "pm.test(\"One alert triggered\", function () { pm.expect(json.data.triggered_alerts).to.have.lengthOf(1); });"
                ]
              }
            }
          ]
        },
