                {
                  "key": "role",
                  "value": "operator"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "-created_at"
                }
